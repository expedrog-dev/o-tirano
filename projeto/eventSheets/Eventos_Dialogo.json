          "id": "set-at-xyz",
          "objectClass": "DadosDialogo",
          "sid": 228889847268839,
          "parameters": {
            "x": "1",
            "y": "5",
            "z": "6",
            "value": "\"Você sabe de alguma coisa.\""
          }
        },
