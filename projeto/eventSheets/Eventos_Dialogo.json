          "id": "set-at-xyz",
          "objectClass": "DadosDialogo",
          "sid": 124666728661195,
          "parameters": {
            "x": "1",
            "y": "1",
            "z": "6",
            "value": "\"Por quê? Estou perto demais da verdade?\"\n"
          }
        },
        {
          "id": "set-at-xyz",
          "objectClass": "DadosDialogo",
          "sid": 335475747677984,
