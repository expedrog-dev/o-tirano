          "objectClass": "DadosDialogo",
          "sid": 629521660896157,
          "parameters": {
            "x": "1",
            "y": "1",
            "z": "5",
            "value": "\"Há verdades que trazem mais dor que silêncio.\""
          }
        },
        {
          "id": "set-at-xyz",
          "objectClass": "DadosDialogo",
