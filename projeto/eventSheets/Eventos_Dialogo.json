            "x": "0",
            "y": "3",
            "z": "6",
            "value": "\"Édipo\""
          }
        },
        {
          "id": "set-at-xyz",
          "objectClass": "DadosDialogo",
          "sid": 604801066256608,
          "parameters": {
            "x": "1",
            "y": "3",
            "z": "6",
            "value": "\"Laio morreu numa encruzilhada. Eu matei um homem numa encruzilhada.\""
