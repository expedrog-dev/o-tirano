          "id": "set-at-xyz",
          "objectClass": "DadosDialogo",
          "sid": 318104872914845,
          "parameters": {
            "x": "1",
            "y": "2",
            "z": "6",
            "value": "\"Algumas verdades deveriam permanecer enterradas.\""
