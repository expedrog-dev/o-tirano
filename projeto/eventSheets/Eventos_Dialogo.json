        {
          "id": "set-at-xyz",
          "objectClass": "DadosDialogo",
          "sid": 105595827024600,
          "parameters": {
            "x": "1",
            "y": "2",
            "z": "5",
            "value": "\"Não vim buscar enigmas.\""
          }
        },
        {
          "id": "set-at-xyz",
          "objectClass": "DadosDialogo",
          "sid": 128425951128598,
          "parameters": {
            "x": "1",
            "y": "2",
            "z": "5",
            "value": "\"Não vim buscar enigmas.\""
          }
        },
