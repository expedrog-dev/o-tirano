          "id": "set-at-xyz",
          "objectClass": "DadosDialogo",
          "sid": 962024990122864,
          "parameters": {
            "x": "0",
            "y": "6",
            "z": "6",
            "value": "\"Jocasta\""
          }
        },
        {
          "id": "set-at-xyz",
          "objectClass": "DadosDialogo",
          "sid": 988864966090229,
          "parameters": {
            "x": "1",
            "y": "6",
            "z": "6",
            "value": "\"Por favor... não procure mais.\""
          }
        },
        {
          "id": "set-at-xyz",
          "objectClass": "DadosDialogo",
          "sid": 828446437310497,
          "parameters": {
            "x": "0",
            "y": "7",
            "z": "6",
            "value": "\"Édipo\""
          }
        },
        {
          "id": "set-at-xyz",
          "objectClass": "DadosDialogo",
          "sid": 972158395899093,
          "parameters": {
            "x": "1",
            "y": "7",
            "z": "6",
            "value": "\"Agora eu preciso saber.\""
          }
        }
