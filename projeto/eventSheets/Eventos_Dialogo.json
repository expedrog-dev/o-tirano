          "parameters": {
            "x": "0",
            "y": "3",
            "z": "5",
            "value": "\"Tirésias\""
          }
        },
        {
          "id": "set-at-xyz",
          "objectClass": "DadosDialogo",
          "sid": 641628734751139,
          "parameters": {
            "x": "1",
            "y": "3",
            "z": "5",
            "value": "\"Então escute: o homem que procura está mais perto do que imagina.\""
