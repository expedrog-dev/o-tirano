            "x": "0",
            "y": "4",
            "z": "5",
            "value": "\"Édipo\""
          }
        },
        {
          "id": "set-at-xyz",
          "objectClass": "DadosDialogo",
          "sid": 902183391906777,
          "parameters": {
            "x": "1",
            "y": "4",
            "z": "5",
            "value": "\"Está me acusando?\""
          }
        },
