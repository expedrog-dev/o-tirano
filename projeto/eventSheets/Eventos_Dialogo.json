          "sid": 791035235668275,
          "parameters": {
            "x": "1",
            "y": "1",
            "z": "2",
            "value": "\"O que aconteceu com a cidade?\""
          }
        },
        {
          "id": "set-at-xyz",
          "objectClass": "DadosDialogo",
          "sid": 971790026628623,
          "parameters": {
            "x": "0",
            "y": "2",
            "z": "2",
            "value": "\"Cidadão\""
          }
        },
        {
          "id": "set-at-xyz",
          "objectClass": "DadosDialogo",
          "sid": 691737554316927,
          "parameters": {
            "x": "1",
            "y": "2",
            "z": "2",
            "value": "\"Uma doença tomou nossas casas. Todos os dias perdemos mais pessoas.\""
          }
        },
        {
          "id": "set-at-xyz",
          "objectClass": "DadosDialogo",
          "sid": 625478614745543,
          "parameters": {
            "x": "0",
            "y": "3",
            "z": "2",
            "value": "\"Cidadão\""
          }
        },
